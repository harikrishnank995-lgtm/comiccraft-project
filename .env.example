# Copy this file to .env. Never share your real API keys or commit .env to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_API_KEY=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# true = app can run in demo mode without API keys.
# Set false when you want API errors to be shown instead of demo fallbacks.
DEMO_MODE=true
